{
  "name": "openclaw-photon",
  "version": "0.1.0",
  "description": "Photon-backed iMessage channel plugin for OpenClaw with durable delivery safety.",
  "repository": {
    "type": "git",
    "url": "https://github.com/trac3r00/openclaw-photon.git"
  },
  "homepage": "https://github.com/trac3r00/openclaw-photon#readme",
  "bugs": {
    "url": "https://github.com/trac3r00/openclaw-photon/issues"
  },
  "keywords": [
    "openclaw",
    "clawhub",
    "photon",
    "imessage",
    "channel-plugin"
  ],
  "type": "module",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "spectrum-ts": "8.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4",
    "openclaw": "2026.8.2",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "openclaw": ">=2026.8.2"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "photon",
      "configuredState": {
        "env": {
          "allOf": [
            "OPENCLAW_PHOTON_PROJECT_ID",
            "OPENCLAW_PHOTON_PROJECT_SECRET"
          ]
        }
      },
      "label": "Photon",
      "selectionLabel": "Photon (iMessage)",
      "docsLabel": "photon",
      "blurb": "Private iMessage transport through Photon Spectrum.",
      "order": 100,
      "quickstartAllowFrom": true,
      "setup": {
        "fields": [
          {
            "key": "phone",
            "kind": "string",
            "cli": {
              "flags": "--phone <number>",
              "description": "Operator phone number in E.164 format"
            }
          }
        ]
      }
    },
    "install": {
      "clawhubSpec": "clawhub:openclaw-photon",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.8.2"
    },
    "compat": {
      "pluginApi": ">=2026.8.2",
      "minGatewayVersion": "2026.8.2"
    },
    "build": {
      "openclawVersion": "2026.8.2",
      "pluginSdkVersion": "2026.8.2"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": false
    }
  },
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
  },
  "private": false,
  "license": "MIT",
  "bin": {
    "openclaw-photon": "./dist/src/cli.js"
  },
  "overrides": {
    "@opentelemetry/core": "2.8.0"
  }
}
